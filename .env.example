# Database
#  Local mongod : mongodb://127.0.0.1:27017/the-daily-web
#  Atlas        : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/the-daily-web
MONGO_URI=mongodb://127.0.0.1:27017/the-daily-web

# Server
PORT=8000

# Auth & Security
JWT_SECRET=your_jwt_secret_here
ADMIN_SIGNUP_CODE=your_admin_signup_code_here
COOKIE_NAME=token
BCRYPT_ROUNDS=10
COOKIE_NAME=cookie
