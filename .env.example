# Database
#  Local mongod : mongodb://127.0.0.1:27017/the-daily-web
#  Atlas        : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/the-daily-web
MONGO_URI=mongodb://127.0.0.1:27017/the-daily-web

# Server
PORT=8000
# Set to "development" locally to see full error stack traces in the browser.
# Leave unset (or "production") everywhere else — errors are logged server-side instead.
NODE_ENV=development

# Auth & Security
JWT_SECRET=your_jwt_secret_here
COOKIE_NAME=token
BCRYPT_ROUNDS=10

# Demo data (npm run seed): password of all seeded users. Required for a non-local database.
# SEED_PASSWORD=
