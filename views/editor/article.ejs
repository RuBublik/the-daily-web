<%- include('../partials/header') %>
  <section class="editor-article" id="editor-article" data-article-id="<%= article._id %>">
    <a class="back-link" href="/editor">Back to all articles</a>

    <header class="editor-article-header">
      <h1 dir="auto"><%= row.title %></h1>
      <p class="editor-article-meta">
        <span class="status-pill <%= article.status %>"><%= article.status %></span>
        <% if (row.isUpdate) { %><span class="update-badge">update to a published article</span><% } %>
        · By <%= article.authorName %>
        · Last updated <time datetime="<%= article.lastUpdated.toISOString() %>"><%= article.lastUpdated.toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %></time>
        <% if (isPublic) { %>
          · Published <time datetime="<%= article.publishDate.toISOString() %>"><%= article.publishDate.toLocaleDateString('en-US', { dateStyle: 'medium' }) %></time>
          · <a href="/article/<%= article._id %>">Public page</a>
        <% } %>
      </p>
    </header>

    <% if (article.editorNote) { %>
      <div class="editor-note">
        <strong>Note to the reporter:</strong>
        <p dir="auto"><%= article.editorNote %></p>
      </div>
    <% } %>

    <p class="editor-message" id="editor-message" aria-live="polite"></p>

    <%# a button that can't be used stays visible but grayed out, with the reason as its tooltip %>
    <div class="editor-actions">
      <button type="button" data-edit-form="edit-draft-form"
        <%- hasDraft ? '' : 'disabled title="No draft: nobody is working on a new version of this article"' %>>Edit draft</button>
      <button type="button" data-edit-form="edit-live-form"
        <%- isPublic ? '' : 'disabled title="No live version: this article was never published"' %>>Edit live</button>
      <% if (canReview) { %>
        <button type="button" class="primary" id="approve-button">Approve and publish</button>
      <% } %>
    </div>

    <% if (canReview) { %>
      <form class="return-form" id="return-form">
        <label for="return-note">Return to the reporter, with a note on what to fix</label>
        <textarea id="return-note" name="note" rows="3" maxlength="1000" required></textarea>
        <button type="submit">Return for revision</button>
      </form>
    <% } %>

    <% if (hasDraft) { %>
      <%- include('../partials/editor-edit-form', {
        target: 'draft',
        heading: 'Edit draft',
        notes: ['Saving does not affect the public version.'],
        version: article.draft,
        saveLabel: 'Save draft',
      }) %>
    <% } %>
    <% if (isPublic) { %>
      <%- include('../partials/editor-edit-form', {
        target: 'live',
        heading: 'Edit live version',
        notes: hasDraft
          ? ['Saving publishes the changes immediately.', 'This article also has a draft.']
          : ['Saving publishes the changes immediately.'],
        version: article,
        saveLabel: 'Save and publish',
      }) %>
    <% } %>

    <div class="versions" id="versions">
      <% if (article.draft) { %>
        <%- include('../partials/editor-article-version', {
          kind: 'pending',
          heading: isPublic ? 'New version (waiting for approval)' : 'Submitted version',
          version: article.draft,
        }) %>
      <% } %>
      <% if (isPublic) { %>
        <%- include('../partials/editor-article-version', {
          kind: 'live',
          heading: 'Live version',
          version: article,
        }) %>
      <% } %>
    </div>

    <div class="editor-actions danger-zone">
      <button type="button" class="danger" id="delete-button">Delete article</button>
    </div>
  </section>
  <script src="/js/editorArticle.js"></script>
<%- include('../partials/footer') %>
