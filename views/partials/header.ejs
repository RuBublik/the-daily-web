<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <% if (typeof description !== 'undefined') { %><meta name="description" content="<%= description %>"><% } %>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <header>
      <div class="site-header-top">
        <a class="site-title" href="/">The Daily Web</a>
        <%- include('auth-bar') %>
      </div>
      <%# tabs to the areas of the logged-in user; the server checks access again on every request %>
      <% if (locals.user) { %>
        <% const path = locals.currentPath || ''; %>
        <nav class="site-tabs" aria-label="Sections">
          <a href="/" class="<%= path === '/' ? 'active' : '' %>">Home</a>
          <% if (user.role === 'editor') { %>
            <a href="/editor" class="<%= path.startsWith('/editor') ? 'active' : '' %>">Editor area</a>
          <% } %>
        </nav>
      <% } %>
    </header>
    <main class="container">
