<%- include('../partials/header') %>
  <section class="reporter-area">
    <div class="reporter-heading">
      <h1 class="section-title">My articles</h1>
      <button type="button" class="new-article-button" id="new-article-button">New article</button>
    </div>
    <p class="editor-message" id="reporter-message" aria-live="polite"></p>

    <form class="editor-filters" id="reporter-filters" action="/reporter" method="get">
      <label>
        Status
        <select name="status">
          <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All</option>
          <% statuses.forEach((status) => { %>
            <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option>
          <% }); %>
        </select>
      </label>
      <noscript><button type="submit">Filter</button></noscript>
    </form>

    <div class="editor-table-wrapper">
      <table class="editor-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Status</th>
            <th>Last updated</th>
          </tr>
        </thead>
        <tbody id="reporter-articles">
          <% articles.forEach((article) => { %>
            <%- include('../partials/reporter-article-row', { article }) %>
          <% }); %>
        </tbody>
      </table>
    </div>

    <p class="editor-list-status" id="reporter-list-status" aria-live="polite"><%= articles.length === 0 ? 'No articles found.' : '' %></p>
    <button type="button" class="load-more" id="reporter-load-more" <%= hasMore ? '' : 'hidden' %>>Load more</button>
  </section>
  <script src="/js/reporter.js"></script>
<%- include('../partials/footer') %>
